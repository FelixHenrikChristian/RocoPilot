<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="AppIconFont">ms-appx:///Assets/Fonts/FluentSystemIcons-Regular.ttf#FluentSystemIcons-Regular</FontFamily>

    <Style x:Key="ExpanderHeaderIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource AppIconFont}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Microsoft Fluent System Icons, Regular, 20 px. -->
    <x:String x:Key="FlowerSeedGlyph">&#xF4D1;</x:String>
    <x:String x:Key="LegendaryPetGlyph">&#xF06F;</x:String>
    <x:String x:Key="ChallengeTargetGlyph">&#xF7B8;</x:String>
    <x:String x:Key="BattleCountGlyph">&#xF57D;</x:String>
    <x:String x:Key="ChallengeDifficultyGlyph">&#xF4C7;</x:String>
    <x:String x:Key="BattleSettingsGlyph">&#xF587;</x:String>
    <x:String x:Key="LegendaryMarkGlyph">&#xEA2F;</x:String>
    <x:String x:Key="NormalBattleGlyph">&#xF6BE;</x:String>
    <x:String x:Key="AutoBattleGlyph">&#xE1B8;</x:String>
    <x:String x:Key="EncounterCountGlyph">&#xF33F;</x:String>
    <x:String x:Key="StartGlyph">&#xF605;</x:String>
    <x:String x:Key="OverlayInfoGlyph">&#xF4A3;</x:String>
    <x:String x:Key="FileFolderGlyph">&#xF42E;</x:String>
    <x:String x:Key="WindowsNotificationGlyph">&#xF114;</x:String>
    <x:String x:Key="CatalogSourceGlyph">&#xE466;</x:String>
    <x:String x:Key="SpiritCatalogGlyph">&#xE178;</x:String>
    <x:String x:Key="CatalogSyncGlyph">&#xF190;</x:String>
    <x:String x:Key="EncounterActionGlyph">&#xE1DE;</x:String>
    <x:String x:Key="OtherSettingsGlyph">&#xF6A9;</x:String>
</ResourceDictionary>
