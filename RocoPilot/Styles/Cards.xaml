<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="ExpanderHeaderPadding">16,14,16,14</Thickness>
    <x:Double x:Key="ExpanderMinHeight">64</x:Double>

    <Thickness x:Key="ExpanderContentPadding">0</Thickness>
    <Thickness x:Key="ExpanderContentDownPadding">0</Thickness>
    <Thickness x:Key="ExpanderContentUpPadding">0</Thickness>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CardExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <!-- 行内第一列放图标，固定 24 宽、列间距 12，文字与折叠面板标题左对齐。 -->
    <Style x:Key="CardRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <!-- 页面标题左侧的图标方块。 -->
    <Style x:Key="PageHeaderIconTileStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="EmptyStatePanelStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
    </Style>

</ResourceDictionary>
