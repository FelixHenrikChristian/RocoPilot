<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="ExpanderHeaderPadding">16,14,16,14</Thickness>
    <x:Double x:Key="ExpanderMinHeight">64</x:Double>

    <Thickness x:Key="ExpanderContentPadding">0</Thickness>
    <Thickness x:Key="ExpanderContentDownPadding">0</Thickness>
    <Thickness x:Key="ExpanderContentUpPadding">0</Thickness>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CardExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="CardRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

</ResourceDictionary>
