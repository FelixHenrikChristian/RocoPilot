<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="ExpanderHeaderPadding">16,14,16,14</Thickness>
    <x:Double x:Key="ExpanderMinHeight">64</x:Double>

    <Thickness x:Key="ExpanderContentPadding">0</Thickness>
    <Thickness x:Key="ExpanderContentDownPadding">0</Thickness>
    <Thickness x:Key="ExpanderContentUpPadding">0</Thickness>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="CardExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="64" />
    </Style>

    <Style x:Key="CardRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="56" />
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="SectionCardHeaderStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="SectionCardBodyStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="ConfigPageRootStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="24,20,24,28" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="ConfigPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="ConfigPageDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="ConfigSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SkillKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style x:Key="ReleaseStepChipStyle" TargetType="Border">
        <Setter Property="Width" Value="108" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="PresetRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ConfigHintBarStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Thickness x:Key="DialogFooterPadding">20,12</Thickness>
    <x:Double x:Key="DialogFooterButtonMinWidth">96</x:Double>
    <x:Double x:Key="DialogFooterMessageBarMaxWidth">480</x:Double>

    <Style x:Key="DialogFooterStyle" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource DialogFooterPadding}" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="ColumnSpacing" Value="10" />
    </Style>

    <Style x:Key="DialogFooterPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource DialogFooterButtonMinWidth}" />
    </Style>

    <Style x:Key="DialogFooterSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinWidth" Value="{StaticResource DialogFooterButtonMinWidth}" />
    </Style>

    <Style x:Key="DialogFooterMessageBarStyle" TargetType="InfoBar">
        <Setter Property="MaxWidth" Value="{StaticResource DialogFooterMessageBarMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsClosable" Value="False" />
    </Style>

    <Style x:Key="EmptyStatePanelStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Spacing" Value="8" />
    </Style>

</ResourceDictionary>
