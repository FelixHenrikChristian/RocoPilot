<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogFieldTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DialogCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="DialogFooterStyle" TargetType="Grid">
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="DialogSettingRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="ColumnSpacing" Value="24" />
    </Style>


    <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    </Style>

    <Style x:Key="DialogPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    </Style>

    <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    </Style>

    <Style x:Key="DialogNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="DialogSectionCardStyle" TargetType="Border" BasedOn="{StaticResource DialogCardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DialogSectionHeaderStyle" TargetType="Grid">
        <Setter Property="Padding" Value="20,16,20,8" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="DialogSectionBodyStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="20,8,20,20" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="DialogPageRootStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="24,16,24,20" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="ConfigSummaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SkillKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ReleaseStepChipStyle" TargetType="Border">
        <Setter Property="Width" Value="108" />
        <Setter Property="Height" Value="64" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="PresetRowStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ConfigHintBarStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <DataTemplate x:Key="DialogTitleTemplate">
        <TextBlock Text="{Binding}" Style="{StaticResource DialogTitleTextStyle}" />
    </DataTemplate>
    <Style x:Key="AppContentDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="TitleTemplate" Value="{StaticResource DialogTitleTemplate}" />
        <Setter Property="PrimaryButtonStyle" Value="{StaticResource DialogPrimaryButtonStyle}" />
        <Setter Property="SecondaryButtonStyle" Value="{StaticResource DialogButtonStyle}" />
        <Setter Property="CloseButtonStyle" Value="{StaticResource DialogButtonStyle}" />
    </Style>
</ResourceDictionary>
