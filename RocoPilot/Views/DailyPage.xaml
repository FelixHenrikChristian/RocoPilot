<Page
    x:Class="RocoPilot.Views.DailyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:vm="using:RocoPilot.ViewModels">

    <Page.Resources>
        <!-- 配置行右侧控件的宽度：下拉框整宽，数字框加单位后与之左对齐。 -->
        <x:Double x:Key="DailyOptionWidth">168</x:Double>
        <x:Double x:Key="DailyNumberWidth">146</x:Double>

        <Style x:Key="DailyDividerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>

        <!-- 图标占 24 宽，标题与下方各行的文字左对齐（和折叠面板的标题一致）。 -->
        <Style x:Key="DailyGroupIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource AppIconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DailyRowIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource AppIconFont}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DailyRowHintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="DailyUnitTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,12,20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左：每日清单。内容少时卡片随内容收起，放不下时只滚动列表。 -->
        <Border
            Padding="0"
            VerticalAlignment="Top"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,14,12,14" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="每日清单" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ListSummary, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleRunCommand}"
                        IsEnabled="{x:Bind ViewModel.CanStartOrStop, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StartButtonText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="14"
                                Glyph="{x:Bind ViewModel.StartButtonGlyph, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.StartButtonLabel, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource DailyDividerStyle}" />

                <ListView
                    Grid.Row="2"
                    Padding="0,2"
                    AllowDrop="True"
                    CanDragItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    CanReorderItems="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="10,0,8,0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DailyTaskItemViewModel">
                            <Grid MinHeight="40" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 正在执行的一项：整行底色，范围与列表项的悬停底色一致。 -->
                                <Border
                                    Grid.ColumnSpan="5"
                                    Margin="-6,2,-4,2"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}" />

                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppIconFont}"
                                    FontSize="16"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Glyph="{StaticResource DragHandleGlyph}"
                                    ToolTipService.ToolTip="拖动排序" />
                                <FontIcon
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource AppIconFont}"
                                    FontSize="18"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <ProgressRing
                                    Grid.Column="3"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="执行中"
                                    IsActive="{x:Bind IsRunning, Mode=OneWay}"
                                    ToolTipService.ToolTip="执行中"
                                    Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                                <ToggleSwitch
                                    Grid.Column="4"
                                    Width="44"
                                    MinWidth="44"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                    IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent=""
                                    Visibility="{x:Bind IsAvailable}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="待接入"
                                    Visibility="{x:Bind IsUnavailable}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Grid.Row="3" Style="{StaticResource DailyDividerStyle}" />

                <Button
                    Grid.Row="4"
                    Margin="4"
                    Padding="10,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.ResetCommand}"
                    ToolTipService.ToolTip="恢复每日任务的默认顺序、开关和配置">
                    <Button.Resources>
                        <!-- 任务运行期间按钮不可用，这时不显示灰色底板。 -->
                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="13"
                            Glyph="&#xE7A7;" />
                        <TextBlock FontSize="12" Text="恢复默认" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 右：已启用任务的配置，每个任务一张卡片。右侧留出滚动条的位置。 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="720" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="12">

                    <Border
                        Padding="0"
                        Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind ViewModel.StaminaCraftingTask.IsEnabled, Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel>
                            <StackPanel Padding="16,12" Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource DailyGroupIconStyle}" Glyph="{x:Bind ViewModel.StaminaCraftingTask.Glyph, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="体力合成" />
                            </StackPanel>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource ChallengeTargetGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="合成目标" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="赛季球或者凝练印记" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="体力合成目标"
                                    IsEnabled="{x:Bind Challenges.IsStaminaCraftingConfigurationEnabled, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.StaminaCraftingTargetIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="赛季球" />
                                    <ComboBoxItem Content="凝练印记" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="0"
                        Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind ViewModel.FlowerSeedTask.IsEnabled, Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel>
                            <StackPanel Padding="16,12" Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource DailyGroupIconStyle}" Glyph="{x:Bind ViewModel.FlowerSeedTask.Glyph, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="花种挑战" />
                            </StackPanel>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource ChallengeTargetGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="挑战目标" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="从已扫描的花种中选择" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="花种挑战目标"
                                    DisplayMemberPath="DisplayName"
                                    IsEnabled="{x:Bind Challenges.IsFlowerSeedConfigurationEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind Challenges.FlowerSeedOptions}"
                                    PlaceholderText="请先在任务页扫描"
                                    SelectedItem="{x:Bind ViewModel.SelectedFlowerSeed, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource BattleCountGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="战斗次数" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="每成功捕捉一次计一场" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        Width="{StaticResource DailyNumberWidth}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="花种挑战战斗次数"
                                        IsEnabled="{x:Bind Challenges.IsFlowerSeedConfigurationEnabled, Mode=OneWay}"
                                        Maximum="99"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.FlowerSeedRunCount, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource DailyUnitTextStyle}" Text="次" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="0"
                        Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind ViewModel.LegendaryTask.IsEnabled, Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel>
                            <StackPanel Padding="16,12" Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource DailyGroupIconStyle}" Glyph="{x:Bind ViewModel.LegendaryTask.Glyph, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="传说精灵挑战" />
                            </StackPanel>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource ChallengeTargetGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="挑战目标" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="选择本轮挑战的传说精灵" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="传说精灵挑战目标"
                                    IsEnabled="{x:Bind Challenges.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind Challenges.LegendaryTargets}"
                                    PlaceholderText="请先在任务页扫描"
                                    SelectedItem="{x:Bind ViewModel.SelectedLegendaryTarget, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource ChallengeDifficultyGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="难度" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="进入挑战时使用此难度" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="传说精灵挑战难度"
                                    IsEnabled="{x:Bind Challenges.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind Challenges.LegendaryDifficulties}"
                                    SelectedIndex="{x:Bind ViewModel.SelectedLegendaryDifficultyIndex, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource BattleCountGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="战斗次数" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="每成功捕捉一次计一场" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        Width="{StaticResource DailyNumberWidth}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="传说精灵挑战战斗次数"
                                        IsEnabled="{x:Bind Challenges.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                        Maximum="99"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.LegendaryChallengeRunCount, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource DailyUnitTextStyle}" Text="次" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="0"
                        Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind ViewModel.GardeningTask.IsEnabled, Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel>
                            <StackPanel Padding="16,12" Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource DailyGroupIconStyle}" Glyph="{x:Bind ViewModel.GardeningTask.Glyph, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="自动种菜" />
                            </StackPanel>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource ReuseLastGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="沿用上次设置" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="不重新选种，直接用游戏里已装备的种子" />
                                </StackPanel>
                                <ToggleSwitch
                                    Grid.Column="2"
                                    Width="44"
                                    MinWidth="44"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="自动种菜沿用上次设置"
                                    IsEnabled="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                                    IsOn="{x:Bind ViewModel.ReuseEquippedSeed, Mode=TwoWay}"
                                    OffContent=""
                                    OnContent="" />
                            </Grid>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource GardenSeedGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="种子" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="要装备并播种的种子" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="自动种菜种子"
                                    IsEnabled="{x:Bind ViewModel.CanSelectGardenSeed, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.SaleFlowers}"
                                    SelectedItem="{x:Bind ViewModel.GardenSeed, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource GardenPlotGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="每格颗数" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="每格田地播下的种子数" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="自动种菜每格颗数"
                                    IsEnabled="{x:Bind ViewModel.CanSelectGardenSeed, Mode=OneWay}"
                                    SelectedIndex="{x:Bind ViewModel.SeedCountIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="1 颗" />
                                    <ComboBoxItem Content="2 颗" />
                                    <ComboBoxItem Content="3 颗" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="0"
                        Style="{StaticResource CardStyle}"
                        Visibility="{x:Bind ViewModel.SaleTask.IsEnabled, Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel>
                            <StackPanel Padding="16,12" Orientation="Horizontal" Spacing="12">
                                <FontIcon Style="{StaticResource DailyGroupIconStyle}" Glyph="{x:Bind ViewModel.SaleTask.Glyph, Mode=OneWay}" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="自动出售" />
                            </StackPanel>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource SaleItemGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="出售的花" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="在农作物出售站卖出的品种" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="2"
                                    Width="{StaticResource DailyOptionWidth}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="自动出售的花"
                                    IsEnabled="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.SaleFlowers}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSaleFlower, Mode=TwoWay}" />
                            </Grid>
                            <Border Style="{StaticResource DailyDividerStyle}" />
                            <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Style="{StaticResource DailyRowIconStyle}" Glyph="{StaticResource BattleCountGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="出售数量" />
                                    <TextBlock Style="{StaticResource DailyRowHintStyle}" Text="每次运行卖出的数量" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        Width="{StaticResource DailyNumberWidth}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="自动出售数量"
                                        IsEnabled="{x:Bind ViewModel.CanReorder, Mode=OneWay}"
                                        Maximum="2147483647"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind ViewModel.SaleQuantity, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource DailyUnitTextStyle}" Text="朵" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 已启用的任务都不需要配置时，右侧不留空白。 -->
        <StackPanel
            Grid.Column="1"
            MaxWidth="280"
            Margin="0,0,12,0"
            Style="{StaticResource EmptyStatePanelStyle}"
            Visibility="{x:Bind ViewModel.IsConfigurationEmpty, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontFamily="{StaticResource AppIconFont}"
                FontSize="28"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="{StaticResource NoOptionsGlyph}" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="没有需要配置的任务" />
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                HorizontalTextAlignment="Center"
                Text="启用体力合成、花种挑战、传说精灵挑战、自动种菜或自动出售后，在这里设置。"
                TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar
            x:Name="DailyNotice"
            Title="每日任务"
            Grid.ColumnSpan="2"
            Margin="4,0,16,0"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            Canvas.ZIndex="10"
            Severity="Warning"
            Style="{StaticResource AppToastStyle}" />
    </Grid>
</Page>
