<ContentDialog
    x:Class="RocoPilot.Views.EncounterSeasonReminderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="赛季资料已到期"
    CloseButtonText="本次关闭"
    CornerRadius="12"
    DefaultButton="Close"
    PrimaryButtonText="不再提示">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">540</x:Double>
        <Thickness x:Key="ContentDialogPadding">28,28,28,24</Thickness>
        <Thickness x:Key="ContentDialogTitleMargin">0,0,0,24</Thickness>
    </ContentDialog.Resources>

    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>

    <ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="40"
                    Height="40"
                    Background="{ThemeResource InfoBarWarningSeverityBackgroundBrush}"
                    CornerRadius="12">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE787;" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </ContentDialog.TitleTemplate>

    <StackPanel Spacing="20">
        <Border
            Padding="16,14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <TextBlock
                FontSize="14"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                LineHeight="24"
                Text="{x:Bind Reminder.SeasonSummary}"
                TextWrapping="Wrap" />
        </Border>

        <TextBlock
            FontSize="15"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            LineHeight="26"
            Text="{x:Bind Reminder.ImpactMessage}"
            TextWrapping="Wrap" />

        <Grid
            Padding="0,16,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE82D;" />
            <TextBlock
                Grid.Column="1"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                LineHeight="22"
                Text="{x:Bind Reminder.CatalogHint}"
                TextWrapping="Wrap" />
        </Grid>
    </StackPanel>
</ContentDialog>
