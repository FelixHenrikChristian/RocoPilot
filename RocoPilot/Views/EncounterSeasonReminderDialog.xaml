<controls:AppContentDialog
    xmlns:controls="using:RocoPilot.Controls"
    x:Class="RocoPilot.Views.EncounterSeasonReminderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="赛季资料已到期"
    TitleGlyph="&#xE787;"
    Tone="Caution"
    CloseButtonText="本次关闭"
    CloseButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    DefaultButton="Close"
    PrimaryButtonText="不再提示"
    PrimaryButtonStyle="{StaticResource DialogButtonStyle}">

    <ScrollViewer
        x:Name="ReminderScrollViewer"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ReminderContent" Spacing="12">
            <Border Style="{StaticResource DialogCardStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{x:Bind ConfiguredSeasonDisplay}"
                                   Style="{StaticResource DialogSectionTitleStyle}" />
                        <TextBlock Text="{x:Bind EndDateDisplay}"
                                   Style="{StaticResource DialogCaptionTextStyle}" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind Reminder.ImpactMessage}" FontSize="13"
                               LineHeight="20" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ConfigHintBarStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE82D;" Style="{StaticResource DialogRowIconStyle}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Reminder.CatalogHint}"
                               Style="{StaticResource DialogCaptionTextStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:AppContentDialog>
