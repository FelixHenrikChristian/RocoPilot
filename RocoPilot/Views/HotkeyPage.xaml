<Page
    x:Class="RocoPilot.Views.HotkeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:RocoPilot.ViewModels"
    KeyDown="HotkeyPage_KeyDown"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="HotkeyGroupTemplate">
            <Grid
                MinHeight="40"
                Padding="0,2,16,2"
                ColumnSpacing="10"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{Binding Content.Glyph}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Content.Name}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HotkeyBindingTemplate">
            <Grid
                MinHeight="56"
                Padding="0,6,16,6"
                ColumnSpacing="16"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{Binding Content.Glyph}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Content.Name}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Content.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    DataContext="{Binding Content}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Click="BindingButton_Click"
                    ToolTipService.ToolTip="点击后设置或重新设置，Esc 可清除">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{Binding DisplayText, Mode=OneWay}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel
                Padding="{StaticResource NavigationViewPageContentPadding}"
                Spacing="16">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        Margin="0,2,0,0"
                        VerticalAlignment="Top"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE765;" />

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="热键"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="仅在实时任务运行且目标游戏窗口为焦点时触发。点击热键后重新设置，Esc 可清除。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Padding="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="16,12,24,10"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="44,0,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="功能"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="热键"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Padding="8,4,8,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <TreeView
                                x:Name="HotkeyTreeView"
                                Background="Transparent"
                                SelectionMode="None" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Margin="{StaticResource NavigationViewPageContentPadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}" />
    </Grid>
</Page>
