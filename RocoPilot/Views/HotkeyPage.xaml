<Page
    x:Class="RocoPilot.Views.HotkeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:RocoPilot.ViewModels"
    KeyDown="HotkeyPage_KeyDown"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="HotkeyKeycapStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="MaxWidth" Value="240" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1,1,1,3" />
        </Style>
        <DataTemplate x:Key="HotkeyGroupTemplate">
            <Grid
                MinHeight="36"
                Padding="0,4,16,4"
                ColumnSpacing="10"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="16"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{Binding Content.Glyph}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="{Binding Content.Name}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HotkeyBindingTemplate">
            <Grid
                MinHeight="52"
                Padding="0,8,16,8"
                ColumnSpacing="16"
                HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{Binding Content.Glyph}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Content.Name}" TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Content.Description}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Column="2" DataContext="{Binding Content}" VerticalAlignment="Center">
                    <Button
                        HorizontalAlignment="Right"
                        Style="{StaticResource HotkeyKeycapStyle}"
                        Click="BindingButton_Click"
                        AutomationProperties.Name="{Binding Name}"
                        ToolTipService.ToolTip="点击录入快捷键；录入时按 Esc 清除">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                     Visibility="{Binding CaptureIndicatorVisibility, Mode=OneWay}" />
                            <TextBlock Text="{Binding DisplayText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                        </StackPanel>
                    </Button>
                    <Border CornerRadius="6" BorderThickness="2" IsHitTestVisible="False"
                            BorderBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Visibility="{Binding CaptureIndicatorVisibility, Mode=OneWay}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel
                Padding="{StaticResource NavigationViewPageContentPadding}"
                Spacing="16">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="40" Height="40" CornerRadius="12" VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon FontSize="20" Glyph="&#xE765;"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="热键"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="实时任务运行且游戏窗口处于前台时生效。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Padding="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            Padding="20,14,24,12"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Margin="0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="功能"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="热键"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            Padding="8,4,8,8"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <TreeView
                                x:Name="HotkeyTreeView"
                                Background="Transparent"
                                SelectionMode="None" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,0">
                    <FontIcon FontSize="12" Glyph="&#xE946;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="点击后按下新快捷键；按 Esc 清除当前绑定。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}" />
    </Grid>
</Page>
