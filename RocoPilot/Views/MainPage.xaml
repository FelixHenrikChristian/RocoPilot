<Page
    x:Class="RocoPilot.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel
            x:Name="ContentArea"
            Padding="{StaticResource NavigationViewPageContentPadding}"
            Spacing="16">

            <Border
                x:Name="CoverContainer"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                SizeChanged="CoverContainer_SizeChanged">
                <Border.Background>
                    <ImageBrush
                        AlignmentX="Center"
                        AlignmentY="Center"
                        ImageSource="/Assets/LaunchPageCover.png"
                        Stretch="UniformToFill" />
                </Border.Background>
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0.72,0">
                                <GradientStop Color="#D9000000" Offset="0" />
                                <GradientStop Color="#70000000" Offset="0.48" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <StackPanel
                        MaxWidth="520"
                        Margin="16,0,24,20"
                        VerticalAlignment="Bottom"
                        Spacing="3">
                        <TextBlock
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="RocoPilot"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="14"
                            Foreground="#C9D4E5"
                            Text="基于图像识别的桌面自动化工具"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Style="{StaticResource CardExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE768;" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="启动任务"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="展开后配置任务启动前需要确认的基础项。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ToggleRealtimeCaptureCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="{x:Bind ViewModel.StartStopButtonGlyph, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.StartStopButtonText, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="0">
                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B9;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="截图方式" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选择实时截图任务使用的捕获后端。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.CaptureMethods}"
                            SelectedItem="{x:Bind ViewModel.SelectedCaptureMethod, Mode=TwoWay}" />
                    </Grid>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8D4;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="OCR 识别方法" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="选择所有 OCR 任务使用的文字识别后端。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{x:Bind ViewModel.TextRecognitionMethods}"
                            SelectedItem="{x:Bind ViewModel.SelectedTextRecognitionMethod, Mode=TwoWay}"
                            ToolTipService.ToolTip="PaddleOCR 效果最好，推荐使用。" />
                    </Grid>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE823;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="运行频率" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="频率越高响应越及时，但会增加资源占用；一般建议保留默认值。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ConfigureRuntimeRecognitionButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE713;" />
                                <TextBlock Text="配置" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE890;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="显示识别区域" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="启动后叠加截图识别区域框。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.IsMaskOverlayEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource CardExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE946;" />

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="信息遮罩窗口"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="显示当前状态、奇遇计数等运行信息。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.IsInfoOverlayEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </Expander.Header>

                <StackPanel Spacing="0">
                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE72E;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="锁定位置" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="关闭后允许用户拖动信息遮罩窗口。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.IsInfoOverlayLocked, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE777;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="重置位置" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="恢复到游戏窗口右侧附着的默认位置。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ResetInfoOverlayPositionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE777;" />
                                <TextBlock Text="重置" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
        </ScrollViewer>

        <InfoBar
            Margin="{StaticResource NavigationViewPageContentPadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsLaunchNotificationOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.LaunchNotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.LaunchNotificationSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.LaunchNotificationTitle, Mode=OneWay}" />
    </Grid>
</Page>
