<Page
    x:Class="RocoPilot.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <StackPanel x:Name="ContentArea" Padding="{StaticResource NavigationViewPageContentPadding}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <FontIcon
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Glyph="&#xE713;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="应用设置" />
            </StackPanel>

            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE771;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="切换主题" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在浅色与暗色主题间进行切换，默认为系统主题"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="120"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedThemeOption, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Expander Margin="0,0,0,8" Style="{StaticResource CardExpanderStyle}">
                <Expander.Header>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="20"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE7C3;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="日志" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="管理日志文件与诊断行为"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="0">
                    <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xEBE8;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="诊断模式" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后将记录更详细的日志（Debug 级），反馈问题前请先开启并复现"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind ViewModel.DiagnosticMode, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Border
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <Grid ColumnSpacing="12" Style="{StaticResource CardRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE838;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="日志文件" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="在资源管理器中打开日志所在目录"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                            ToolTipService.ToolTip="打开日志目录">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="16"
                                Glyph="&#xE838;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Expander>

            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE777;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="恢复设置" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="恢复应用程序的用户偏好设置，重置后须重启生效"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.ResetSettingsCommand}"
                        ToolTipService.ToolTip="重置所有用户偏好（重启后生效）">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE777;" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,12">
                <FontIcon
                    Margin="0,0,8,0"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="18"
                    Glyph="&#xE946;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="关于" />
            </StackPanel>

            <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.VersionDescription, Mode=OneWay}"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Settings_AboutDescription"
                        Margin="{StaticResource XSmallTopMargin}"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <HyperlinkButton
                        x:Uid="SettingsPage_PrivacyTermsLink"
                        Margin="{StaticResource SettingsPageHyperlinkButtonMargin}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
