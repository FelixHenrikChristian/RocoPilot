<controls:AppContentDialog
    x:Class="RocoPilot.Views.SettingsResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:RocoPilot.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="重置设置"
    TitleGlyph="&#xE777;"
    Tone="Critical"
    PrimaryButtonText="重置并退出"
    PrimaryButtonStyle="{StaticResource DialogButtonStyle}"
    CloseButtonText="取消"
    CloseButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    DefaultButton="Close">

    <ScrollViewer x:Name="ResetScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ResetContent" Spacing="12">
            <Border Style="{StaticResource DialogCardStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="恢复默认设置"
                                   Style="{StaticResource DialogSectionTitleStyle}" />
                        <TextBlock Text="确认后应用将立即退出。"
                                   Style="{StaticResource DialogCaptionTextStyle}" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE783;" Style="{StaticResource DialogRowIconStyle}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="将清除用户偏好、全部账号统计记录和云同步配置。"
                                   FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ConfigHintBarStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74E;" Style="{StaticResource DialogRowIconStyle}" />
                    <TextBlock Grid.Column="1" Text="已导出的备份文件会保留。"
                               Style="{StaticResource DialogCaptionTextStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:AppContentDialog>
