<controls:AppContentDialog
    x:Class="RocoPilot.Views.StatisticsAccountAddDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:RocoPilot.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="添加账号"
    TitleGlyph="&#xE8FA;"
    PrimaryButtonText="添加"
    PrimaryButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    CloseButtonText="取消"
    CloseButtonStyle="{StaticResource DialogButtonStyle}"
    DefaultButton="Primary">

    <ScrollViewer x:Name="AccountScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="AccountContent" Spacing="12">
            <Border Style="{StaticResource DialogCardStyle}" Padding="16">
                <TextBox x:Name="UidTextBox"
                         Header="账号 UID" MaxLength="32"
                         PlaceholderText="请输入游戏内 UID"
                         Style="{StaticResource DialogTextBoxStyle}" />
            </Border>
            <Border Style="{StaticResource ConfigHintBarStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" Style="{StaticResource DialogRowIconStyle}" />
                    <TextBlock Grid.Column="1" Text="添加后将切换到该账号的统计记录。"
                               Style="{StaticResource DialogCaptionTextStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:AppContentDialog>
