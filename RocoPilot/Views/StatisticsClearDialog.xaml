<controls:AppContentDialog
    x:Class="RocoPilot.Views.StatisticsClearDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:RocoPilot.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="清空记录"
    TitleGlyph="&#xE74D;"
    Tone="Critical"
    PrimaryButtonText="清空"
    PrimaryButtonStyle="{StaticResource DialogButtonStyle}"
    CloseButtonText="取消"
    CloseButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    DefaultButton="Close">

    <ScrollViewer x:Name="ClearScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ClearContent" Spacing="12">
            <Border Style="{StaticResource DialogCardStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="清空全部统计数据"
                                   Style="{StaticResource DialogSectionTitleStyle}" />
                        <TextBlock Text="作用于所有账号与全部赛季。"
                                   Style="{StaticResource DialogCaptionTextStyle}" />
                    </StackPanel>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE783;" Style="{StaticResource DialogRowIconStyle}"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="将删除所有账号及其奇遇、异色和暂存记录。"
                                   FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ConfigHintBarStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74E;" Style="{StaticResource DialogRowIconStyle}" />
                    <TextBlock Grid.Column="1" Text="已导出的备份文件会保留。"
                               Style="{StaticResource DialogCaptionTextStyle}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:AppContentDialog>
