<Page
    x:Class="RocoPilot.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="StatisticsCardStyle"
            BasedOn="{StaticResource CardStyle}"
            TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="PollutionCountRowTemplate">
            <Grid
                MinHeight="32"
                ColumnSpacing="8"
                RightTapped="PollutionCountItem_RightTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE77B;" />
                </Border>

                <Grid
                    Grid.Column="1"
                    Height="24"
                    VerticalAlignment="Center">
                    <Border
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="4" />
                    <Border
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4"
                        RenderTransformOrigin="0,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ProgressRatio}" />
                        </Border.RenderTransform>
                    </Border>
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding Count}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShinyCountRowTemplate">
            <Grid
                MinHeight="32"
                ColumnSpacing="8"
                RightTapped="ShinyCountItem_RightTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE77B;" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />

                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding Count}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ShinyCaptureDetailTemplate">
            <Grid
                Width="430"
                MinHeight="220"
                Padding="24,10,24,20"
                RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding SeasonDisplay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        MinWidth="58"
                        Height="30"
                        Padding="10,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding PositionDisplay}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.35*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="16,14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="异色前奇遇" />
                            <TextBlock
                                FontSize="26"
                                FontWeight="SemiBold"
                                Text="{Binding EncounterCountDisplay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16,14"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="获取时间" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding CapturedDateDisplay}" />
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding CapturedTimeDisplay}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid Padding="{StaticResource NavigationViewPageContentPadding}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="17"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE9D2;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="统计" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Width="220"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch">
                <Button.Content>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.SelectedAccountDisplayName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <FontIcon
                            Grid.Column="1"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button.Content>
                <Button.Flyout>
                    <Flyout x:Name="AccountSelectorFlyout" Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="220" Spacing="6">
                            <ListView
                                MaxHeight="260"
                                IsItemClickEnabled="True"
                                ItemClick="AccountListView_ItemClick"
                                ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            MinHeight="36"
                                            Padding="10,0"
                                            RightTapped="AccountItem_RightTapped">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding DisplayName}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Button
                                HorizontalAlignment="Stretch"
                                Click="AddAccountButton_Click">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE710;" />
                                    <TextBlock Text="添加账号" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="15"
                        Glyph="&#xE713;" />
                    <TextBlock Text="设置" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Click="ImportStatisticsMenuFlyoutItem_Click" Text="导入数据" />
                        <MenuFlyoutItem Click="ExportStatisticsMenuFlyoutItem_Click" Text="导出数据" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="ClearStatisticsMenuFlyoutItem_Click" Text="清空记录" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource StatisticsCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="异色" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.SelectedShinyDateDisplay, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <InfoBadge
                                Value="{x:Bind ViewModel.PendingShinyCount, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.PendingShinyBadgeVisibility, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.TotalSelectedShiny, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0" />

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        RightTapped="ShinyBlank_RightTapped"
                        VerticalScrollBarVisibility="Hidden"
                        ViewChanged="CardScrollViewer_ViewChanged"
                        ViewChanging="CardScrollViewer_ViewChanging"
                        VerticalScrollMode="Auto">
                        <ItemsControl
                            Margin="0,0,10,0"
                            ItemTemplate="{StaticResource ShinyCountRowTemplate}"
                            ItemsSource="{x:Bind ViewModel.SelectedShinyCounts, Mode=OneWay}" />
                    </ScrollViewer>

                    <ComboBox
                        Grid.Row="3"
                        Width="120"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.ShinyScopes, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SelectedShinyScopeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <FlipView
                Grid.Column="2"
                Background="Transparent"
                ItemsSource="{x:Bind ViewModel.Seasons, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedSeasonIndex, Mode=TwoWay}">
                <FlipView.ItemContainerStyle>
                    <Style TargetType="FlipViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </FlipView.ItemContainerStyle>
                <FlipView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource StatisticsCardStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="2">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Text="{Binding EncounterTitle}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding SeasonDateDisplay}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding PollutionTotal}" />
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0" />

                                <ScrollViewer
                                    Grid.Row="2"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    RightTapped="PollutionBlank_RightTapped"
                                    VerticalScrollBarVisibility="Hidden"
                                    ViewChanged="CardScrollViewer_ViewChanged"
                                    ViewChanging="CardScrollViewer_ViewChanging"
                                    VerticalScrollMode="Auto">
                                    <ItemsControl
                                        Margin="0,0,10,0"
                                        ItemTemplate="{StaticResource PollutionCountRowTemplate}"
                                        ItemsSource="{Binding PollutionCounts}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>
        </Grid>
        </Grid>

        <InfoBar
            Canvas.ZIndex="10"
            Margin="{StaticResource NavigationViewPageContentPadding}"
            VerticalAlignment="Bottom"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsNotificationOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.NotificationSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}" />

        <Grid
            Canvas.ZIndex="9"
            Background="#99000000"
            Visibility="{x:Bind ViewModel.PendingShinyConfirmationVisibility, Mode=OneWay}">
            <Border
                Width="560"
                MaxWidth="560"
                Padding="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Width="32"
                            Height="32"
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="24"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE7BA;" />

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="发现异色精灵"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="确认后会计入异色统计，并重置对应精灵的赛季奇遇计数。"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBadge
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Value="{x:Bind ViewModel.PendingShinyCount, Mode=OneWay}" />
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="PendingShinyNameTextBox"
                            Header="精灵名"
                            MaxLength="32"
                            PlaceholderText="仅支持中文、英文和短横线"
                            Text="{x:Bind ViewModel.PendingShinyEditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <NumberBox
                            Grid.Column="1"
                            Header="当前奇遇计数"
                            Minimum="0"
                            SmallChange="1"
                            LargeChange="5"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.PendingShinyEditEncounterCount, Mode=TwoWay}" />

                        <Border
                            Grid.Row="1"
                            Padding="12"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="赛季" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.PendingShinySeasonDisplay, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Padding="12"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="识别时间" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.PendingShinyDetectedAtDisplay, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.PendingShinyQueueDisplay, Mode=OneWay}" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="DiscardPendingShinyButton_Click" Content="忽略" />
                        <Button
                            Click="ConfirmPendingShinyButton_Click"
                            Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="14"
                                    Glyph="&#xE73E;" />
                                <TextBlock Text="确认计入" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
