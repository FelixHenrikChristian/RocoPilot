<controls:AppContentDialog
    x:Class="RocoPilot.Views.StatisticsRecordDeleteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:RocoPilot.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="删除"
    PrimaryButtonStyle="{StaticResource DialogButtonStyle}"
    CloseButtonText="取消"
    CloseButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    DefaultButton="Close">

    <ScrollViewer x:Name="RecordScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RecordContent" Spacing="12">
            <Border Style="{StaticResource DialogCardStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <Image Source="{x:Bind Avatar}" Margin="3" Stretch="Uniform"
                                       Visibility="{x:Bind AvatarVisibility}" />
                                <FontIcon Glyph="&#xE77B;" FontSize="22"
                                          Visibility="{x:Bind AvatarFallbackVisibility}"
                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind SpiritName}" FontSize="16" FontWeight="SemiBold"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind CountLabel}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind CountValue}" FontSize="14"
                                   FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Text="{x:Bind SecondLabel}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind SecondValue}" FontSize="13"
                                   TextWrapping="Wrap" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="2" Text="最近记录" FontSize="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind LatestVisibility}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind LatestValue}" FontSize="13"
                                   Visibility="{x:Bind LatestVisibility}"
                                   TextWrapping="Wrap" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ConfigHintBarStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE783;" FontSize="16" VerticalAlignment="Center"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind DeleteScope}" FontSize="13" LineHeight="20" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind RetainedInfo}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:AppContentDialog>
