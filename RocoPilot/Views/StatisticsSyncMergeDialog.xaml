<controls:AppContentDialog
    x:Class="RocoPilot.Views.StatisticsSyncMergeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:RocoPilot.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="合并云端数据"
    PrimaryButtonText="合并"
    PrimaryButtonStyle="{StaticResource DialogButtonStyle}"
    CloseButtonText="取消"
    CloseButtonStyle="{StaticResource DialogPrimaryButtonStyle}"
    DefaultButton="Close">

    <ScrollViewer x:Name="RulesScrollViewer"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RulesContent" Spacing="12">
            <Border Style="{StaticResource DialogCardStyle}" Padding="16">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xE753;" FontSize="18"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="按账号合并统计数据"
                                       Style="{StaticResource DialogSectionTitleStyle}" />
                            <TextBlock Text="按账号版本判断先后，冲突时由你核对选择。" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="清零、删除和新增都属于账号修改：" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Grid.Row="0" Glyph="&#xE770;" FontSize="16"
                                  VerticalAlignment="Center"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="3">
                            <TextBlock Text="仅本机发生变化" Style="{StaticResource DialogFieldTitleStyle}" />
                            <TextBlock Text="保留本机版本" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon Grid.Row="1" Glyph="&#xE753;" FontSize="16"
                                  VerticalAlignment="Center"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="3">
                            <TextBlock Text="仅云端发生变化" Style="{StaticResource DialogFieldTitleStyle}" />
                            <TextBlock Text="采用云端版本" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <FontIcon Grid.Row="2" Glyph="&#xE895;" FontSize="16"
                                  VerticalAlignment="Center"
                                  FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        <StackPanel Grid.Column="1" Grid.Row="2" Spacing="3">
                            <TextBlock Text="两端都发生变化，且内容不同" Style="{StaticResource DialogFieldTitleStyle}" />
                            <TextBlock Text="保留双方数据，核对后选择" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ConfigHintBarStyle}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE783;" FontSize="16" VerticalAlignment="Center"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Grid.Column="1" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="冲突处理以整个账号为单位。选择前请核对奇遇、异色及删除状态；取消会保留双方数据。" />
                </Grid>
            </Border>
            <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="首次同步遇到无法判断先后的旧数据，也会提示核对。各设备请升级后再同步；换设备前确认上传成功。" />
        </StackPanel>
    </ScrollViewer>
</controls:AppContentDialog>
