<Page
    x:Class="RocoPilot.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <StackPanel
                Padding="{StaticResource NavigationViewPageContentPadding}"
                Spacing="16">

                <Expander Style="{StaticResource CardExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xEB9F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock FontWeight="SemiBold" Text="花种挑战" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="自动选择花种、连续战斗并捕捉，完成后退出。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="ToggleFlowerSeedChallengeButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsFlowerSeedChallengeButtonEnabled, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="{x:Bind ViewModel.FlowerSeedChallengeButtonGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.FlowerSeedChallengeButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Spacing="0">
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8F1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="目标花种" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="扫描当前花种后，选择要挑战的目标。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <ComboBox
                                    Width="200"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="DisplayName"
                                    IsEnabled="{x:Bind ViewModel.IsFlowerSeedConfigurationEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.FlowerSeedOptions}"
                                    PlaceholderText="请先扫描花种"
                                    SelectedItem="{x:Bind ViewModel.SelectedFlowerSeed, Mode=TwoWay}" />
                                <Button
                                    VerticalAlignment="Center"
                                    Width="32" Height="32" Padding="0"
                                    AutomationProperties.Name="{x:Bind ViewModel.FlowerSeedScanButtonLabel, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.FlowerSeedScanButtonLabel, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.ToggleFlowerSeedScanCommand}"
                                    IsEnabled="{x:Bind ViewModel.IsFlowerSeedScanButtonEnabled, Mode=OneWay}">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"
                                        Glyph="{x:Bind ViewModel.FlowerSeedScanButtonGlyph, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8EE;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="战斗次数" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="成功捕捉后计数；失败自动重试，连续失败 3 次后停止。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    Width="96"
                                    VerticalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.IsFlowerSeedConfigurationEnabled, Mode=OneWay}"
                                    Maximum="99"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.FlowerSeedRunCount, Mode=TwoWay}" />
                                <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="次" />
                            </StackPanel>
                        </Grid>
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE9F5;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="战斗配置" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="独立配置花种释放顺序，可插入公共执行序列。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsFlowerSeedConfigurationEnabled, Mode=OneWay}"
                                Click="ConfigureFlowerSeedBattleButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE713;" />
                                    <TextBlock Text="配置" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Style="{StaticResource CardExpanderStyle}">
                    <Expander.Header>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="20"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE734;" />

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="传说精灵"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="自动挑战目标精灵、选择印记并捕捉，完成后退出。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ToggleLegendaryChallengeCommand}"
                                IsEnabled="{x:Bind ViewModel.IsLegendaryChallengeButtonEnabled, Mode=OneWay}"
                                ToolTipService.ToolTip="按设定次数挑战并捕捉目标精灵。">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="{x:Bind ViewModel.LegendaryChallengeButtonGlyph, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind ViewModel.LegendaryChallengeButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>

                    <StackPanel Spacing="0">
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />

                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8F1;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="目标精灵" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="选择要挑战的传说精灵。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="2"
                                Width="160"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.LegendaryTargets}"
                                SelectedItem="{x:Bind ViewModel.SelectedLegendaryTarget, Mode=TwoWay}" />
                        </Grid>

                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE9D9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="挑战难度" />
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="开始挑战前选择指定难度。" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" Width="140" VerticalAlignment="Center"
                                AutomationProperties.Name="传说精灵挑战难度"
                                IsEnabled="{x:Bind ViewModel.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.LegendaryDifficulties}"
                                SelectedIndex="{x:Bind ViewModel.SelectedLegendaryDifficultyIndex, Mode=TwoWay}" />
                        </Grid>
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE8EE;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="战斗次数" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="成功捕捉后计数；失败自动重试，连续失败 3 次后停止。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    Width="96"
                                    VerticalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                    Maximum="99"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.LegendaryChallengeRunCount, Mode=TwoWay}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="次" />
                            </StackPanel>
                        </Grid>
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE734;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="使用传说印记" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="体力或周捕捉次数不足时使用；关闭后遇到不足提示即停止。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                Width="44"
                                MinWidth="44"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="0"
                                AutomationProperties.Name="体力或周捕捉次数不足时使用传说印记"
                                IsEnabled="{x:Bind ViewModel.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.UseLegendaryMarkWhenInsufficient, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />
                        <Grid ColumnSpacing="16" Style="{StaticResource CardRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE9F5;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="战斗配置" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="独立配置传说精灵释放顺序，可插入公共执行序列。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind ViewModel.IsLegendaryChallengeConfigurationEnabled, Mode=OneWay}"
                                Click="ConfigureLegendaryBattleButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE713;" />
                                    <TextBlock Text="配置" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="{x:Bind ViewModel.IsTaskNotificationOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.TaskNotificationMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.TaskNotificationSeverity, Mode=OneWay}"
            Title="{x:Bind ViewModel.TaskNotificationTitle, Mode=OneWay}" />
    </Grid>
</Page>
