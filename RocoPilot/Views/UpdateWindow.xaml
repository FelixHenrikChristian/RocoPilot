<windowex:WindowEx
    x:Class="RocoPilot.Views.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="680"
    Height="600"
    MinWidth="540"
    MinHeight="420"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootHost" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarRoot"
            Grid.Row="0"
            Height="32"
            Padding="12,0,12,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                Source="/Assets/WindowIcon.ico" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource DialogDescriptionTextStyle}"
                Text="发现新版本" />
        </Grid>

        <Grid
            x:Name="ContentRoot"
            Grid.Row="1"
            Margin="24,12,24,12"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Style="{StaticResource DialogCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="18"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE946;" />

                    <StackPanel
                        Grid.Column="1"
                        Spacing="4">
                        <TextBlock
                            x:Name="VersionTitleText"
                            Style="{StaticResource DialogSectionTitleStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PublishDateText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                MinHeight="0"
                Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid
                        Padding="16,14"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE8E8;" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource DialogSectionTitleStyle}"
                            Text="更新内容" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        MinHeight="120">
                        <WebView2
                            x:Name="ReleaseNotesWebView"
                            MinHeight="120"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch" />
                        <ScrollViewer
                            x:Name="ReleaseNotesFallbackHost"
                            Padding="16,12"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="ReleaseNotesFallbackText"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <Grid Grid.Row="2" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                HorizontalAlignment="Left"
                Click="DownloadButton_Click"
                Style="{StaticResource DialogButtonStyle}"
                ToolTipService.ToolTip="前往 GitHub 手动下载安装包">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE8A7;" />
                    <TextBlock Text="手动下载" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                Click="CancelButton_Click"
                Content="稍后提醒"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="UpdateButton_Click"
                Style="{StaticResource DialogPrimaryButtonStyle}"
                ToolTipService.ToolTip="使用内置更新程序下载并安装">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE896;" />
                    <TextBlock Text="立即更新" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</windowex:WindowEx>
