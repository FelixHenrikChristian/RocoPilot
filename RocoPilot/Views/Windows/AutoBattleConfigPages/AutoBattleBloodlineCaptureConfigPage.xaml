<Page
    x:Class="RocoPilot.Views.Windows.AutoBattleConfigPages.AutoBattleBloodlineCaptureConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/DialogControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#1B1B1B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="BloodlineOptionStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="{ThemeResource SystemAccentColor}" />

        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Style="{StaticResource DialogPageRootStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE8D7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Style="{StaticResource DialogTitleTextStyle}" Text="捕捉血脉" />
                    <TextBlock Style="{StaticResource DialogDescriptionTextStyle}" Text="仅用于普通战斗，且「奇遇解除操作」选择捕捉时生效。" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DialogSectionCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource DialogSectionHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8D7;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource DialogSectionTitleStyle}" Text="启用血脉筛选" />
                            <TextBlock
                                Style="{StaticResource DialogDescriptionTextStyle}"
                                Text="{x:Bind Editor.BloodlineCaptureFilterSummary, Mode=OneWay}" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            Width="44"
                            MinWidth="44"
                            HorizontalAlignment="Right"
                            Padding="0"
                            VerticalAlignment="Center"
                            IsOn="{x:Bind Editor.BloodlineCaptureFilterEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <StackPanel Style="{StaticResource DialogSectionBodyStyle}">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="选中的血脉尝试捕捉，其余按普通战斗配置释放战技。"
                            TextWrapping="Wrap" />

                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="92" ItemHeight="46">
                            <ToggleButton Margin="0,0,8,8"
                                          Style="{StaticResource BloodlineOptionStyle}" Content="奇异"
                                          IsChecked="{x:Bind Editor.CaptureBloodlineQiYi, Mode=TwoWay}" IsEnabled="{x:Bind Editor.BloodlineCaptureFilterOptionsEnabled, Mode=OneWay}" />
                            <ToggleButton Margin="0,0,8,8"
                                          Style="{StaticResource BloodlineOptionStyle}" Content="污染"
                                          IsChecked="{x:Bind Editor.CaptureBloodlineWuRan, Mode=TwoWay}" IsEnabled="{x:Bind Editor.BloodlineCaptureFilterOptionsEnabled, Mode=OneWay}" />
                            <ToggleButton Margin="0,0,8,8"
                                          Style="{StaticResource BloodlineOptionStyle}" Content="混血"
                                          IsChecked="{x:Bind Editor.CaptureBloodlineHunXue, Mode=TwoWay}" IsEnabled="{x:Bind Editor.BloodlineCaptureFilterOptionsEnabled, Mode=OneWay}" />
                            <ToggleButton Margin="0,0,8,8"
                                          Style="{StaticResource BloodlineOptionStyle}" Content="普通"
                                          IsChecked="{x:Bind Editor.CaptureBloodlineNormal, Mode=TwoWay}" IsEnabled="{x:Bind Editor.BloodlineCaptureFilterOptionsEnabled, Mode=OneWay}" />
                            <ToggleButton Margin="0,0,8,8"
                                          Style="{StaticResource BloodlineOptionStyle}" Content="未识别"
                                          IsChecked="{x:Bind Editor.CaptureBloodlineUnrecognized, Mode=TwoWay}" IsEnabled="{x:Bind Editor.BloodlineCaptureFilterOptionsEnabled, Mode=OneWay}" />
                        </VariableSizedWrapGrid>

                        <Border Style="{StaticResource ConfigHintBarStyle}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="按提示文字识别血脉，不区分赛季。无法识别时使用「未识别」选项。"
                                    ToolTipService.ToolTip="识别提示中的「奇异、混乱、污染、特性」。"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
