<Page
    x:Class="RocoPilot.Views.Windows.AutoBattleConfigPages.AutoBattleBossConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Style="{StaticResource ConfigPageRootStyle}">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource ConfigPageTitleStyle}" Text="首领战斗" />
                <TextBlock
                    Style="{StaticResource ConfigPageDescriptionStyle}"
                    Text="独立配置连招提示出现前的循环释放序列，以及提示出现后的首领连招。" />
            </StackPanel>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SectionCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8FD;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="连招前释放序列" />
                            <TextBlock
                                Style="{StaticResource SectionDescriptionStyle}"
                                Text="与普通战斗完全独立；从左到右循环执行，拖动可重排，右键可删除。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                Click="ResetBossReleaseSequenceButton_Click"
                                ToolTipService.ToolTip="恢复默认释放序列">
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                            </Button>
                            <Button
                                Click="ClearBossReleaseSequenceButton_Click"
                                ToolTipService.ToolTip="清空释放序列">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource SectionCardBodyStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource ConfigSummaryTextStyle}"
                                Text="{x:Bind Editor.BossReleaseSummary, Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="追加" />
                                <Button
                                    Click="AppendBossSkillButton_Click"
                                    Content="1"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="1" />
                                <Button
                                    Click="AppendBossSkillButton_Click"
                                    Content="2"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="2" />
                                <Button
                                    Click="AppendBossSkillButton_Click"
                                    Content="3"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="3" />
                                <Button
                                    Click="AppendBossSkillButton_Click"
                                    Content="4"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="4" />
                                <Button
                                    Click="AppendBossSkillButton_Click"
                                    Content="X"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="X" />
                            </StackPanel>
                        </Grid>

                        <Border
                            MinHeight="180"
                            Padding="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <GridView
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    IsSwipeEnabled="False"
                                    ItemsSource="{x:Bind Editor.BossReleaseItems, Mode=OneWay}"
                                    SelectionMode="None">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Margin" Value="0,0,8,8" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid RightTapped="BossReleaseItem_RightTapped">
                                                <Border Style="{StaticResource ReleaseStepChipStyle}">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding PositionText}" />
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DisplayText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding DetailText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <StackPanel
                                    Style="{StaticResource EmptyStatePanelStyle}"
                                    Visibility="{x:Bind Editor.BossReleaseEmptyVisibility, Mode=OneWay}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE710;" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="点击上方技能键追加步骤" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SectionCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE7FC;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="首领连招" />
                            <TextBlock
                                Style="{StaticResource SectionDescriptionStyle}"
                                Text="按顺序发送配置的技能键，最后自动按 Space 确认；拖动可重排，右键可删除。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                Click="ResetBossComboButton_Click"
                                ToolTipService.ToolTip="恢复默认首领连招">
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                            </Button>
                            <Button
                                Click="ClearBossComboButton_Click"
                                ToolTipService.ToolTip="清空首领连招">
                                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Style="{StaticResource SectionCardBodyStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource ConfigSummaryTextStyle}"
                                Text="{x:Bind Editor.BossComboSummary, Mode=OneWay}" />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="追加" />
                                <Button
                                    Click="AppendBossComboSkillButton_Click"
                                    Content="1"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="1" />
                                <Button
                                    Click="AppendBossComboSkillButton_Click"
                                    Content="2"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="2" />
                                <Button
                                    Click="AppendBossComboSkillButton_Click"
                                    Content="3"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="3" />
                                <Button
                                    Click="AppendBossComboSkillButton_Click"
                                    Content="4"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="4" />
                                <Button
                                    Click="AppendBossComboSkillButton_Click"
                                    Content="X"
                                    Style="{StaticResource SkillKeyButtonStyle}"
                                    Tag="X" />
                            </StackPanel>
                        </Grid>

                        <Border
                            MinHeight="140"
                            Padding="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <GridView
                                    AllowDrop="True"
                                    CanDragItems="True"
                                    CanReorderItems="True"
                                    IsSwipeEnabled="False"
                                    ItemsSource="{x:Bind Editor.BossComboItems, Mode=OneWay}"
                                    SelectionMode="None">
                                    <GridView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </GridView.ItemsPanel>
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Margin" Value="0,0,8,8" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid RightTapped="BossComboItem_RightTapped">
                                                <Border Style="{StaticResource ReleaseStepChipStyle}">
                                                    <Grid>
                                                        <TextBlock
                                                            HorizontalAlignment="Right"
                                                            FontSize="11"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{Binding PositionText}" />
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock
                                                                FontSize="18"
                                                                FontWeight="SemiBold"
                                                                Text="{Binding DisplayText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding DetailText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <StackPanel
                                    Style="{StaticResource EmptyStatePanelStyle}"
                                    Visibility="{x:Bind Editor.BossComboEmptyVisibility, Mode=OneWay}">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontSize="28"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE710;" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="点击上方技能键追加连招步骤" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Padding="12,10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="10,4"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="Space" />
                                </Border>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="连招结束后自动发送确认；能量不足时会临时插入 X 回能。等待 5 分钟仍未结束时尝试自动解卡。"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SectionCardHeaderStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="18"
                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            Glyph="&#xE8F1;" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="公共执行序列" />
                            <TextBlock
                                Style="{StaticResource SectionDescriptionStyle}"
                                Text="将公共序列作为一个动作插入上方释放顺序；在“公共执行序列”页修改后会即时同步。" />
                        </StackPanel>
                    </Grid>

                    <Grid MinHeight="180" Padding="16,14">
                        <ListView
                            ItemsSource="{x:Bind Editor.SharedPresetItems, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PresetRowStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                FontSize="13"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Sequence}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="2"
                                                MinWidth="72"
                                                Click="InsertBossReleasePresetButton_Click"
                                                Content="插入" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{x:Bind Editor.SharedPresetEmptyVisibility, Mode=OneWay}">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Glyph="&#xE8A5;" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="暂无公共序列，请先到左侧页面创建" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
