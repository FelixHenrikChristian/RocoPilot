<Page
    x:Class="RocoPilot.Views.Windows.AutoBattleConfigPages.AutoBattleLegendaryConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Padding="20,16,20,24" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="传说精灵挑战" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="为传说精灵挑战预留的独立战斗配置。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                IsClosable="False"
                IsOpen="True"
                Message="当前版本尚未实现传说精灵挑战的识别与执行逻辑，因此这里暂不提供可保存的专属选项。"
                Severity="Informational"
                Title="功能开发中" />

            <Border Style="{StaticResource CardStyle}">
                <Grid MinHeight="300">
                    <StackPanel
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE734;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="传说精灵挑战暂未实现" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            TextAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="页面结构已经预留。后续接入运行逻辑时，可直接增加专属释放规则，并复用现有公共单回合执行序列。"
                            TextWrapping="Wrap" />
                        <Border
                            Margin="0,8,0,0"
                            Padding="12,8"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Editor.SharedPresetSummary, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
