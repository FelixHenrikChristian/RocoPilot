<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.AutoBattleConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="920"
    Height="680"
    MinWidth="800"
    MinHeight="640"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="BattleNavigationView"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="156"
            PaneDisplayMode="Left"
            SelectionChanged="BattleNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="资源" />
                <NavigationViewItem
                    x:Name="SharedSequencesNavigationItem"
                    Content="公共执行序列"
                    Tag="SharedSequences">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="BloodlineCaptureNavigationItem"
                    Content="捕捉血脉"
                    Tag="BloodlineCapture">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="战斗类型" />
                <NavigationViewItem
                    x:Name="NormalBattleNavigationItem"
                    Content="普通战斗"
                    Tag="Normal">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ContentPresenter x:Name="ConfigPageHost" Margin="0,4,8,8" />
        </NavigationView>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="1"
                Click="CancelButton_Click"
                Content="取消"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            x:Name="MessageBar"
            Grid.RowSpan="2"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="False" />
    </Grid>
</windowex:WindowEx>
