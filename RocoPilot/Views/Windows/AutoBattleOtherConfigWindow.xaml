<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.AutoBattleOtherConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:windowex="using:WinUIEx"
    Width="680"
    Height="580"
    MinWidth="600"
    MinHeight="520">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,16,24,12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="自动战斗高级选项" />
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="会改变识别等待和按键节奏，普通用户建议保留默认值。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,4">
                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid
                                Margin="0,0,0,4"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE823;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="战斗时序" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="识别与动作之间的等待时间"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="技能选择基础等待" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="进入技能选择界面后，开始识别并发送本回合按键前的等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="SkillSelectionActionDelayNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="技能操作重试间隔" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="技能选择界面持续未消失时，再次执行同一动作前的等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="SkillSelectionRetryDelayNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="500"
                                        SmallChange="500"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid
                                Margin="0,0,0,4"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE765;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="按键时序" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="按下时长与连续按键间隔"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="按键按下时长" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="每个按键从按下到松开的持续时间。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="KeyboardHoldDurationNumberBox"
                                        Width="140"
                                        Maximum="2000"
                                        Minimum="10"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="普通按键间隔" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="战技、自定义序列等相邻按键之间的等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="KeyboardIntervalNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="捕捉序列按键间隔" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="奇遇解除后执行 W、1、Space 捕捉序列时的相邻按键等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="CaptureKeyboardIntervalNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Click="RestoreDefaultsButton_Click"
                Content="恢复默认值"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="CancelButton_Click"
                Content="取消"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="3"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            x:Name="MessageBar"
            Grid.RowSpan="2"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="False" />
    </Grid>
</windowex:WindowEx>
