<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.AutoBattleOtherConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:windowex="using:WinUIEx"
    Width="680"
    Height="580"
    MinWidth="600"
    MinHeight="520">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot">
        <Grid.Resources>
            <Style x:Key="AdvancedSettingRowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="72" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>
            <Style x:Key="AdvancedSettingTitleStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AdvancedSettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="20,16,20,12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE7BA;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="自动战斗高级选项" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="会改变识别等待和按键节奏，普通用户建议保留默认值。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,4">
                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid
                                Padding="16,14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE823;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="战斗时序" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="控制识别开始、执行动作和失败重试的等待时间。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AdvancedSettingTitleStyle}" Text="技能选择基础等待" />
                                    <TextBlock
                                        Style="{StaticResource AdvancedSettingDescriptionStyle}"
                                        Text="进入技能选择界面后，开始识别并发送本回合按键前的等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="SkillSelectionActionDelayNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AdvancedSettingTitleStyle}" Text="技能操作重试间隔" />
                                    <TextBlock
                                        Style="{StaticResource AdvancedSettingDescriptionStyle}"
                                        Text="技能选择界面持续未消失时，再次执行同一动作前的等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="SkillSelectionRetryDelayNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="500"
                                        SmallChange="500"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid
                                Padding="16,14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE765;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="按键时序" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="控制单个按键及连续按键之间的节奏。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AdvancedSettingTitleStyle}" Text="按键按下时长" />
                                    <TextBlock
                                        Style="{StaticResource AdvancedSettingDescriptionStyle}"
                                        Text="每个按键从按下到松开的持续时间。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="KeyboardHoldDurationNumberBox"
                                        Width="140"
                                        Maximum="2000"
                                        Minimum="10"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AdvancedSettingTitleStyle}" Text="普通按键间隔" />
                                    <TextBlock
                                        Style="{StaticResource AdvancedSettingDescriptionStyle}"
                                        Text="战技、自定义序列等相邻按键之间的等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="KeyboardIntervalNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource AdvancedSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource AdvancedSettingTitleStyle}" Text="捕捉序列按键间隔" />
                                    <TextBlock
                                        Style="{StaticResource AdvancedSettingDescriptionStyle}"
                                        Text="奇遇解除后执行 W、1、Space 捕捉序列时的相邻按键等待。" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="CaptureKeyboardIntervalNumberBox"
                                        Width="140"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Compact" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="20,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Click="RestoreDefaultsButton_Click"
                Content="恢复默认值" />
            <InfoBar
                x:Name="MessageBar"
                Grid.Column="1"
                helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
                IsClosable="False"
                IsOpen="False" />
            <Button
                Grid.Column="2"
                MinWidth="96"
                Click="CancelButton_Click"
                Content="取消" />
            <Button
                Grid.Column="3"
                MinWidth="96"
                Click="SaveButton_Click"
                Content="保存"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</windowex:WindowEx>
