<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.AutoBattleOtherConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:windowex="using:WinUIEx"
    Width="620"
    Height="580"
    MinWidth="560"
    MinHeight="520">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,16,24,12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE713;" FontSize="20"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Style="{StaticResource DialogTitleTextStyle}" Text="自动战斗高级选项" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="调整识别等待与按键节奏，建议保留默认值。" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,4">
                    <Border Style="{StaticResource DialogCardStyle}" Padding="16" CornerRadius="12">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE823;" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource DialogSectionTitleStyle}" Text="战斗时序" />
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="144" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="技能选择基础等待" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="进入技能界面后，识别与按键前的等待" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="SkillSelectionActionDelayNumberBox"
                                        AutomationProperties.Name="技能选择基础等待（毫秒）"
                                        Width="116"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Hidden" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="144" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="技能操作重试间隔" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="技能界面未消失时，重复动作的等待" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="SkillSelectionRetryDelayNumberBox"
                                        AutomationProperties.Name="技能操作重试间隔（毫秒）"
                                        Width="116"
                                        Maximum="30000"
                                        Minimum="500"
                                        SmallChange="500"
                                        SpinButtonPlacementMode="Hidden" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}" Padding="16" CornerRadius="12">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE765;" FontSize="16"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           Style="{StaticResource DialogSectionTitleStyle}" Text="按键时序" />
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="144" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="按键按下时长" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="单次按键从按下到松开的时间" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="KeyboardHoldDurationNumberBox"
                                        AutomationProperties.Name="按键按下时长（毫秒）"
                                        Width="116"
                                        Maximum="2000"
                                        Minimum="10"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Hidden" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="144" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="普通按键间隔" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="战技与自定义序列中相邻按键的等待" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="KeyboardIntervalNumberBox"
                                        AutomationProperties.Name="普通按键间隔（毫秒）"
                                        Width="116"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Hidden" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="144" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="捕捉序列按键间隔" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="奇遇解除后，W、1、Space 之间的等待" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <NumberBox
                                        x:Name="CaptureKeyboardIntervalNumberBox"
                                        AutomationProperties.Name="捕捉序列按键间隔（毫秒）"
                                        Width="116"
                                        Maximum="30000"
                                        Minimum="0"
                                        SmallChange="100"
                                        SpinButtonPlacementMode="Hidden" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="ms" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Click="RestoreDefaultsButton_Click"
                Content="恢复默认值"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="CancelButton_Click"
                Content="取消"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="3"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            x:Name="MessageBar"
            Grid.RowSpan="2"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="False" />
    </Grid>
</windowex:WindowEx>
