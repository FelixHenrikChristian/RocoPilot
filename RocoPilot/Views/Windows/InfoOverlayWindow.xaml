<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.InfoOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windowex="using:WinUIEx"
    Width="344" Height="220">
    <Grid x:Name="OverlayRoot" Background="Transparent"
          PointerMoved="OverlayRoot_PointerMoved" PointerPressed="OverlayRoot_PointerPressed"
          PointerReleased="OverlayRoot_PointerReleased">
        <Border x:Name="InfoPanel" Padding="14" Background="#EB202026" BorderBrush="#28FFFFFF"
                BorderThickness="1" CornerRadius="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="最近捕捉" FontSize="11" Foreground="#9B9BAA" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="奇遇次数" FontSize="11" Foreground="#9B9BAA" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Auto">
                    <StackPanel x:Name="CounterList" Spacing="7" />
                </ScrollViewer>
                <TextBlock x:Name="RecentRecordTimeText" Grid.Row="2" HorizontalAlignment="Right"
                           FontSize="10" Foreground="#878391" Visibility="Collapsed" />
            </Grid>
        </Border>
        <Border x:Name="IslandPanel" Background="#F018181E" BorderBrush="#30FFFFFF" BorderThickness="1"
                CornerRadius="23" Visibility="Collapsed">
            <Grid Padding="16,11" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="22" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border x:Name="IslandStatusDot" Width="6" Height="6" Background="#34D399" CornerRadius="3" VerticalAlignment="Center" />
                    <TextBlock x:Name="IslandStatusText" Grid.Column="1" Text="状态待识别" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F5F3F7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <Grid Grid.Column="2" ColumnSpacing="7" VerticalAlignment="Center" ToolTipService.ToolTip="魔力值">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                            <Path Width="24" Height="24" Fill="#DEA6EA"
                                  Data="M12,21 L3.6,12.6 C-1.8,7.2 6.6,-1.2 12,4.2 C17.4,-1.2 25.8,7.2 20.4,12.6 Z" />
                        </Viewbox>
                        <TextBlock x:Name="IslandMagicText" Grid.Column="1" Text="-- / 6" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#DEA6EA" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
                <Grid x:Name="IslandDetails" Grid.Row="1" ColumnSpacing="12" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="IslandAvatar" Width="42" Height="42" CornerRadius="12" Background="#18DEA6EA" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="IslandCategoryText" FontSize="10" Foreground="#9B9BAA" />
                        <TextBlock x:Name="IslandTitleText" FontSize="15" FontWeight="SemiBold" Foreground="#F5F3F7" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="IslandDescriptionText" FontSize="12" Foreground="#9B9BAA" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</windowex:WindowEx>
