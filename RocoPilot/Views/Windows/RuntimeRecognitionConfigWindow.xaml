<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.RuntimeRecognitionConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:windowex="using:WinUIEx"
    Width="600"
    Height="460"
    MinWidth="560"
    MinHeight="420">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,16,24,12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE823;" FontSize="20"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock Style="{StaticResource DialogTitleTextStyle}" Text="运行频率" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="调整画面采集与识别的执行间隔" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalContentAlignment="Top"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="10">
                    <Border Style="{StaticResource DialogCardStyle}" Padding="14" CornerRadius="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="144" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE714;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="画面捕获间隔" />
                                <TextBlock
                                    Style="{StaticResource DialogDescriptionTextStyle}"
                                    Text="连续两次画面采集的间隔" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    x:Name="FrameCaptureIntervalNumberBox"
                                    Width="116"
                                    AutomationProperties.Name="画面捕获间隔（毫秒）"
                                    Maximum="30000"
                                    Minimum="16"
                                    SmallChange="10"
                                    SpinButtonPlacementMode="Hidden" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}" Padding="14" CornerRadius="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="144" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="状态识别间隔" />
                                <TextBlock
                                    Style="{StaticResource DialogDescriptionTextStyle}"
                                    Text="扫描魔力值、技能及战斗状态"
                                    ToolTipService.ToolTip="识别魔力值、技能选择、切换精灵和战斗聊天等图像状态。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    x:Name="GameStateScanIntervalNumberBox"
                                    Width="116"
                                    AutomationProperties.Name="状态识别间隔（毫秒）"
                                    Maximum="30000"
                                    Minimum="100"
                                    SmallChange="100"
                                    SpinButtonPlacementMode="Hidden" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}" Padding="14" CornerRadius="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="144" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE8D2;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="OCR 识别间隔" />
                                <TextBlock
                                    Style="{StaticResource DialogDescriptionTextStyle}"
                                    Text="识别奇遇、异色及精灵名称" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    x:Name="OcrScanIntervalNumberBox"
                                    Width="116"
                                    AutomationProperties.Name="OCR 识别间隔（毫秒）"
                                    Maximum="30000"
                                    Minimum="250"
                                    SmallChange="250"
                                    SpinButtonPlacementMode="Hidden" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Margin="2,2,2,0" Style="{StaticResource DialogDescriptionTextStyle}"
                               Text="间隔越短，资源占用越高。建议保留默认值。" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Click="RestoreDefaultsButton_Click"
                Content="恢复默认值"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="CancelButton_Click"
                Content="取消"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="3"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            x:Name="MessageBar"
            Grid.RowSpan="2"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="False" />
    </Grid>
</windowex:WindowEx>
