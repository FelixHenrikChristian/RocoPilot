<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.RuntimeRecognitionConfigWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:windowex="using:WinUIEx"
    Width="680"
    Height="480"
    MinWidth="600"
    MinHeight="420">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,16,24,12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="运行频率" />
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="控制实时任务的画面采集、状态匹配和 OCR 节奏。"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Border Style="{StaticResource DialogCardStyle}">
                    <StackPanel Spacing="16">
                        <Grid Style="{StaticResource DialogSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="画面捕获间隔" />
                                <TextBlock
                                    Style="{StaticResource DialogDescriptionTextStyle}"
                                    Text="连续截图之间的目标间隔；越小越及时，资源占用越高。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    x:Name="FrameCaptureIntervalNumberBox"
                                    Width="140"
                                    Maximum="30000"
                                    Minimum="16"
                                    SmallChange="10"
                                    SpinButtonPlacementMode="Compact" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource DialogSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="状态识别间隔" />
                                <TextBlock
                                    Style="{StaticResource DialogDescriptionTextStyle}"
                                    Text="魔力值、技能选择、切换精灵和战斗聊天等图像状态的扫描间隔。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    x:Name="GameStateScanIntervalNumberBox"
                                    Width="140"
                                    Maximum="30000"
                                    Minimum="100"
                                    SmallChange="100"
                                    SpinButtonPlacementMode="Compact" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>

                        <Grid Style="{StaticResource DialogSettingRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="OCR 识别间隔" />
                                <TextBlock
                                    Style="{StaticResource DialogDescriptionTextStyle}"
                                    Text="奇遇、异色和精灵名称等后台文字识别的扫描间隔。" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <NumberBox
                                    x:Name="OcrScanIntervalNumberBox"
                                    Width="140"
                                    Maximum="30000"
                                    Minimum="250"
                                    SmallChange="250"
                                    SpinButtonPlacementMode="Compact" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="ms" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Click="RestoreDefaultsButton_Click"
                Content="恢复默认值"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="2"
                Click="CancelButton_Click"
                Content="取消"
                Style="{StaticResource DialogButtonStyle}" />
            <Button
                Grid.Column="3"
                Click="SaveButton_Click"
                Content="保存"
                Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>

        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            x:Name="MessageBar"
            Grid.RowSpan="2"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="False" />
    </Grid>
</windowex:WindowEx>
