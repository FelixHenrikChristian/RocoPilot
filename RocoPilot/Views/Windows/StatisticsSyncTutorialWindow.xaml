<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.StatisticsSyncTutorialWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="780"
    Height="740"
    MinWidth="640"
    MinHeight="520"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
                <Style x:Key="StepBadgeStyle" TargetType="Border">
                    <Setter Property="Width" Value="26" />
                    <Setter Property="Height" Value="26" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="TutorialBodyStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="IsTextSelectionEnabled" Value="True" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,16,24,12"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Cloudflare R2 同步教程" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="三步完成连接配置"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="16" Padding="0,0,12,4">
                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel Spacing="24">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="1" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="创建存储桶" />
                                    <TextBlock Style="{StaticResource TutorialBodyStyle}" Text="登录 Cloudflare Dashboard，进入 R2，创建一个 Bucket，例如 roco-pilot。" />
                                    <TextBlock Style="{StaticResource TutorialBodyStyle}" Text="记下 Bucket 名称和账户的 Account ID。" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="2" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="创建访问密钥" />
                                    <TextBlock Style="{StaticResource TutorialBodyStyle}" Text="进入 Manage R2 API tokens，创建仅对该 Bucket 有读写权限的令牌。" />
                                    <TextBlock Style="{StaticResource TutorialBodyStyle}" Text="保存 Access Key ID 和 Secret Access Key；Secret 只显示一次。" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="3" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="保存并测试连接" />
                                    <TextBlock Style="{StaticResource TutorialBodyStyle}" Text="回到云同步窗口，填入 Account ID、Bucket、Access Key ID 和 Secret Access Key。" />
                                    <TextBlock Style="{StaticResource TutorialBodyStyle}" Text="点击“保存配置”，再“测试连接”。需要自动上传时，开启“自动同步”并再次保存。" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="同步功能说明" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="检查云端时间" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TutorialBodyStyle}" Text="只查询云端文件的修改时间，不会下载或合并数据。" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="上传到云端" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TutorialBodyStyle}" Text="上传本地统计；若云端已有更新，会先合并再上传。" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="合并云端数据" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TutorialBodyStyle}" Text="将云端统计合并到本地；同一账号在两台设备同时修改时采用云端版本。" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="自动同步" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TutorialBodyStyle}" Text="启动时检查云端更新；本地统计变化后，约 8 秒自动上传。" />
                            </Grid>
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="云端文件：RocoPilot/statistics.json" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Button
                HorizontalAlignment="Right"
                Click="CloseButton_Click"
                Content="返回配置"
                Style="{StaticResource DialogButtonStyle}" />
        </Grid>
    </Grid>
</windowex:WindowEx>
