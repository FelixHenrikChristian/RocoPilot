<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.StatisticsSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="680"
    Height="620"
    MinWidth="600"
    MinHeight="520"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Loaded="ContentRoot_Loaded">
        <Grid.Resources>
            <Style x:Key="SyncSettingRowStyle" TargetType="Grid">
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
            </Style>
            <Style x:Key="SyncSettingTitleStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SyncSettingDescriptionStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="20,16,20,12"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="20"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE753;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="统计云同步" />
                    <TextBlock
                        x:Name="StatusSummaryText"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>

                <Border
                    x:Name="StatusBadge"
                    Grid.Column="2"
                    MinWidth="72"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="14">
                    <TextBlock
                        x:Name="StatusBadgeText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="未启用" />
                </Border>
            </Grid>

            <InfoBar
                x:Name="MessageBar"
                Grid.Row="1"
                helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
                IsClosable="True"
                IsOpen="False" />

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="12" Padding="0,0,0,4">

                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid
                                Padding="16,14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE72E;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="连接配置" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="填写 Cloudflare R2 凭证后即可同步统计数据。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="同步方式" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="Cloudflare R2 · S3 兼容 API" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ProviderComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="ProviderComboBox_SelectionChanged" />
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="Account ID" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="Cloudflare 账户 ID" />
                                </StackPanel>
                                <TextBox
                                    x:Name="R2AccountIdTextBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Cloudflare Account ID" />
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="Bucket" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="用于保存统计文件的 R2 存储桶" />
                                </StackPanel>
                                <TextBox
                                    x:Name="R2BucketNameTextBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="roco-pilot" />
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="Access Key ID" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="R2 API 令牌的访问密钥 ID" />
                                </StackPanel>
                                <TextBox
                                    x:Name="UserNameTextBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="R2 Access Key ID" />
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="Secret Access Key" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="私钥仅显示一次；留空则保留已保存的密钥" />
                                </StackPanel>
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="输入 Secret Access Key" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid
                                Padding="16,14"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE895;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="同步操作" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="手动同步云端数据，或开启自动上传。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="云端数据" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="刷新云端时间，或与其他设备合并统计" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="RefreshRemoteButton"
                                        MinWidth="0"
                                        Click="RefreshRemoteButton_Click"
                                        ToolTipService.ToolTip="刷新云端更新时间">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE72C;" />
                                            <TextBlock Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="UploadButton"
                                        MinWidth="0"
                                        Click="UploadButton_Click"
                                        ToolTipService.ToolTip="立即上传当前本地统计">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE898;" />
                                            <TextBlock Text="上传" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="DownloadButton"
                                        MinWidth="0"
                                        Click="DownloadButton_Click"
                                        ToolTipService.ToolTip="合并云端数据">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE896;" />
                                            <TextBlock Text="合并" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid Style="{StaticResource SyncSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SyncSettingTitleStyle}" Text="启用同步" />
                                    <TextBlock
                                        Style="{StaticResource SyncSettingDescriptionStyle}"
                                        Text="开启后，本地统计变化会自动上传到云端" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="EnableSyncSwitch"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="EnableSyncSwitch_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TutorialButton"
                Click="TutorialButton_Click"
                Style="{StaticResource DialogFooterSecondaryButtonStyle}"
                ToolTipService.ToolTip="查看 Cloudflare R2 配置教程">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE897;" />
                    <TextBlock Text="教程" />
                </StackPanel>
            </Button>

            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="首次使用建议先保存并测试连接"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <Button
                x:Name="TestConnectionButton"
                Grid.Column="2"
                Click="TestConnectionButton_Click"
                Content="测试连接"
                Style="{StaticResource DialogFooterSecondaryButtonStyle}" />
            <Button
                x:Name="SaveSettingsButton"
                Grid.Column="3"
                Click="SaveSettingsButton_Click"
                Content="保存"
                Style="{StaticResource DialogFooterPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</windowex:WindowEx>
