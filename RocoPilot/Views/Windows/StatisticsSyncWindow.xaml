<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.StatisticsSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="720"
    Height="640"
    MinWidth="640"
    MinHeight="560"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="ContentRoot"
        Padding="18"
        RowSpacing="12"
        Loaded="ContentRoot_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="42"
                Height="42"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <FontIcon
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="21"
                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                    Glyph="&#xE753;" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="统计云同步" />
                <TextBlock
                    x:Name="StatusSummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>

            <Border
                x:Name="StatusBadge"
                Grid.Column="2"
                MinWidth="88"
                Padding="10,5"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBlock
                    x:Name="StatusBadgeText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="未启用" />
            </Border>
        </Grid>

        <InfoBar
            x:Name="MessageBar"
            Grid.Row="1"
            IsOpen="False" />

        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Spacing="12">
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE753;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="同步方式" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Cloudflare R2 · S3 兼容 API"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <ComboBox
                            x:Name="ProviderComboBox"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name"
                            SelectionChanged="ProviderComboBox_SelectionChanged" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8D7;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Account ID" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Cloudflare 账户 ID。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TextBox
                            x:Name="R2AccountIdTextBox"
                            Grid.Column="2"
                            PlaceholderText="Cloudflare Account ID" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8B7;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Bucket" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="用于保存统计文件的 R2 存储桶。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TextBox
                            x:Name="R2BucketNameTextBox"
                            Grid.Column="2"
                            PlaceholderText="roco-pilot" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE8D7;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Access Key ID" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="R2 API 令牌的访问密钥 ID。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <TextBox
                            x:Name="UserNameTextBox"
                            Grid.Column="2"
                            PlaceholderText="R2 Access Key ID" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE72E;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Secret Access Key" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="R2 API 令牌的私钥。留空则保留旧密钥。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <PasswordBox
                            x:Name="PasswordBox"
                            Grid.Column="2"
                            PlaceholderText="输入 Secret Access Key" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE895;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="云端数据" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="查看时间，或合并其他设备的数据。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="RefreshRemoteButton"
                                MinWidth="0"
                                Padding="10,5"
                                Click="RefreshRemoteButton_Click"
                                ToolTipService.ToolTip="刷新云端更新时间">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE72C;" />
                                    <TextBlock Text="刷新" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="UploadButton"
                                MinWidth="0"
                                Padding="10,5"
                                Click="UploadButton_Click"
                                ToolTipService.ToolTip="立即上传当前本地统计">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE898;" />
                                    <TextBlock Text="上传" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="DownloadButton"
                                MinWidth="0"
                                Padding="10,5"
                                Click="DownloadButton_Click"
                                ToolTipService.ToolTip="合并云端数据">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE896;" />
                                    <TextBlock Text="合并" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid Padding="16" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="36"
                            Height="36"
                            VerticalAlignment="Top"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="18"
                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                Glyph="&#xE753;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="启用同步" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="开启后自动上传统计变化。"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Name="EnableSyncSwitch"
                            Grid.Column="2"
                            MinWidth="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            OffContent=""
                            OnContent=""
                            Toggled="EnableSyncSwitch_Toggled" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="首次使用建议先保存并测试连接。"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <Button
                x:Name="TutorialButton"
                Grid.Column="1"
                Click="TutorialButton_Click"
                Content="教程" />
            <Button
                x:Name="TestConnectionButton"
                Grid.Column="2"
                Click="TestConnectionButton_Click"
                Content="测试连接" />
            <Button
                x:Name="SaveSettingsButton"
                Grid.Column="3"
                Click="SaveSettingsButton_Click"
                Content="保存"
                Style="{ThemeResource AccentButtonStyle}" />
            <Button
                Grid.Column="4"
                Click="CloseButton_Click"
                Content="关闭" />
        </Grid>
    </Grid>
</windowex:WindowEx>
