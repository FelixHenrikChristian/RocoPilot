<windowex:WindowEx
    x:Class="RocoPilot.Views.Windows.StatisticsSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:RocoPilot.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowex="using:WinUIEx"
    Width="780"
    Height="740"
    MinWidth="640"
    MinHeight="520"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="ContentRoot" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Loaded="ContentRoot_Loaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/Styles/DialogControls.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,16,24,12"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="36"
                    Height="36"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="18"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE753;" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="统计云同步" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="StatusSummaryText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Button
                            x:Name="RefreshRemoteButton"
                            Grid.Column="1"
                            MinWidth="0"
                            MinHeight="24"
                            Padding="6,2"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Content="检查云端时间"
                            Click="RefreshRemoteButton_Click"
                            ToolTipService.ToolTip="查询云端统计文件的最新修改时间，不会下载或合并数据。" />
                    </Grid>
                </StackPanel>

                <Border
                    x:Name="StatusBadge"
                    Grid.Column="2"
                    MinWidth="72"
                    Padding="12,6"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    CornerRadius="14">
                    <TextBlock
                        x:Name="StatusBadgeText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="未启用" />
                </Border>
            </Grid>


            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Spacing="16" Padding="0,0,12,4">

                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid
                                Margin="0,0,0,4"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE72E;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="连接配置" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="同步方式" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="ProviderComboBox"
                                    AutomationProperties.Name="同步方式"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    DisplayMemberPath="Name"
                                    SelectionChanged="ProviderComboBox_SelectionChanged" />
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="Account ID" VerticalAlignment="Center" />
                                <TextBox
                                    x:Name="R2AccountIdTextBox"
                                    AutomationProperties.Name="Account ID"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Cloudflare Account ID" />
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="Bucket" VerticalAlignment="Center" />
                                <TextBox
                                    x:Name="R2BucketNameTextBox"
                                    AutomationProperties.Name="Bucket"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="roco-pilot" />
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="Access Key ID" VerticalAlignment="Center" />
                                <TextBox
                                    x:Name="UserNameTextBox"
                                    AutomationProperties.Name="Access Key ID"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="R2 Access Key ID" />
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="144" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="Secret Access Key" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="留空保留已保存的密钥" />
                                </StackPanel>
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    AutomationProperties.Name="Secret Access Key"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Secret Access Key" />
                            </Grid>
                            <StackPanel Spacing="10" Margin="0,2,0,0">
                                <Button
                                    x:Name="TestConnectionButton"
                                    Click="TestConnectionButton_Click"
                                    Style="{StaticResource DialogButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Glyph="&#xE71B;" />
                                        <TextBlock Text="测试连接" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource DialogDescriptionTextStyle}" Text="修改配置后，请先保存再测试或同步。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DialogCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid
                                Margin="0,0,0,4"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="18"
                                    Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                    Glyph="&#xE895;" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="同步与数据" />
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="云端数据" VerticalAlignment="Center" />
                                <StackPanel
                                    Grid.Row="1"
                                    Margin="0,14,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="UploadButton"
                                        MinWidth="0"
                                        Style="{StaticResource DialogButtonStyle}"
                                        Click="UploadButton_Click"
                                        ToolTipService.ToolTip="立即上传当前本地统计">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE898;" />
                                            <TextBlock Text="上传到云端" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="DownloadButton"
                                        MinWidth="0"
                                        Style="{StaticResource DialogButtonStyle}"
                                        Click="DownloadButton_Click"
                                        ToolTipService.ToolTip="合并云端数据">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon
                                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                FontSize="14"
                                                Glyph="&#xE896;" />
                                            <TextBlock Text="合并云端数据" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource DialogSettingRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource DialogFieldTitleStyle}" Text="自动同步" />
                                    <TextBlock
                                        Style="{StaticResource DialogDescriptionTextStyle}"
                                        Text="开启后，本地统计变化会自动上传到云端" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="EnableSyncSwitch"
                                    AutomationProperties.Name="启用自动同步"
                                    Grid.Column="1"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    OffContent=""
                                    OnContent=""
                                    Toggled="EnableSyncSwitch_Toggled" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="TutorialButton"
                Click="TutorialButton_Click"
                Content="教程"
                Style="{StaticResource DialogButtonStyle}"
                ToolTipService.ToolTip="查看 Cloudflare R2 配置教程" />

            <Button
                x:Name="SaveSettingsButton"
                Grid.Column="2"
                Click="SaveSettingsButton_Click"
                Content="保存配置"
                Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>

        <!-- Overlay the content instead of allocating a row: notifications must not move the form. -->
        <InfoBar
            Style="{StaticResource AppToastStyle}"
            Canvas.ZIndex="10"
            x:Name="MessageBar"
            Grid.RowSpan="2"
            helpers:InfoBarAutoCloseBehavior.AutoCloseDelayMilliseconds="{StaticResource InfoBarAutoCloseDelayMilliseconds}"
            IsOpen="False" />
    </Grid>
</windowex:WindowEx>
